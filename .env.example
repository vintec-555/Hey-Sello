# Hey Sello — environment variables. Copy to .env.local and fill in.

# ── The agent ────────────────────────────────────────────────────────────────
# Required to run real tasks. Without it, only the simulated preview works.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Durable storage (required for automatic background drafting) ─────────────
# Add a Vercel KV / Upstash Redis store (Vercel → Storage → one click) — it sets
# these automatically. Without it, the app still works on demand but can't run
# in the background (serverless instances don't share a filesystem).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Background poller ────────────────────────────────────────────────────────
# A secret that protects the /api/cron/poll endpoint. Vercel Cron sends it
# automatically; external cron services pass it as ?key=YOUR_SECRET.
CRON_SECRET=

# ── Gmail (Google OAuth) — see INTEGRATIONS.md ──────────────────────────────
# Create an OAuth client at https://console.cloud.google.com (APIs & Services).
# Authorized redirect URI: <your-site>/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production single-account: paste a refresh token (obtained once via the
# in-app "Connect Gmail" flow) so it survives serverless restarts.
GOOGLE_REFRESH_TOKEN=

# ── WhatsApp — pick ONE provider (Twilio is easiest; no Facebook needed) ────
# Option A) Twilio (recommended): console.twilio.com → Messaging → WhatsApp.
#   Inbound webhook: <your-site>/api/whatsapp/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=        # e.g. whatsapp:+14155238886 (Twilio sandbox number)

# Option B) Meta WhatsApp Cloud API: Meta app → WhatsApp → API setup.
#   Inbound webhook: <your-site>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=       # any string you choose; match it in the Meta webhook config

# ── Premium voice (optional) ─────────────────────────────────────────────────
# Natural text-to-speech via ElevenLabs (https://elevenlabs.io). Without it,
# voice falls back to the free browser voice. Optional: override the voice/model.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ── Transactional email (password reset) — optional but recommended ─────────
# Sends the password-reset link. Get a key at https://resend.com. Without it,
# reset emails are skipped (the flow still works if you know the link).
RESEND_API_KEY=
EMAIL_FROM=Hey Sello <noreply@heysello.in>

# ── Billing (Stripe) — optional ──────────────────────────────────────────────
# Enables the "Upgrade to Pro" flow. Create a product + recurring price at
# https://dashboard.stripe.com. Webhook endpoint: <your-site>/api/billing/webhook
# (listen for checkout.session.completed) → copy its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Waitlist (optional) ──────────────────────────────────────────────────────
# Forward signups to Formspree for email + a dashboard.
FORMSPREE_ID=
