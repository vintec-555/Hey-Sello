# Hey Sello — environment variables. Copy to .env.local and fill in.

# ── The agent ────────────────────────────────────────────────────────────────
# Required to run real tasks. Without it, only the simulated preview works.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Gmail (Google OAuth) — see INTEGRATIONS.md ──────────────────────────────
# Create an OAuth client at https://console.cloud.google.com (APIs & Services).
# Authorized redirect URI: <your-site>/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production single-account: paste a refresh token (obtained once via the
# in-app "Connect Gmail" flow) so it survives serverless restarts.
GOOGLE_REFRESH_TOKEN=

# ── WhatsApp (Meta Cloud API) — see INTEGRATIONS.md ─────────────────────────
# From your Meta app → WhatsApp → API setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Any string you choose; enter the same value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=

# ── Premium voice (optional) ─────────────────────────────────────────────────
# Natural text-to-speech via ElevenLabs (https://elevenlabs.io). Without it,
# voice falls back to the free browser voice. Optional: override the voice/model.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ── Waitlist (optional) ──────────────────────────────────────────────────────
# Forward signups to Formspree for email + a dashboard.
FORMSPREE_ID=
