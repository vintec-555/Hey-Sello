# Hey Sello — environment variables

# Required to run the REAL agent (otherwise the app runs in safe "Demo mode").
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: forward waitlist signups to Formspree (email + dashboard).
# Create a form at https://formspree.io and paste its ID (the part after /f/).
FORMSPREE_ID=
